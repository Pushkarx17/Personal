# Cloudflare Pages response headers.
#
# The CSP is what turns "this site contacts no third party" from a promise in
# the privacy policy into something the browser enforces: default-src 'self'
# means any stylesheet, font, image or request pointing off-origin is blocked
# outright, so a third-party tracker cannot be introduced by accident.
#
# 'unsafe-inline' is present because the pages use inline style="" attributes
# for the fade-in delays, the JSON-LD block, and the 404 page's path script.
# There is no user input anywhere on this site, so there is no injection path
# for those to be abused.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'none'; base-uri 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable
